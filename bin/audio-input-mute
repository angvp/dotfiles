#!/bin/bash
wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null
if pactl get-source-mute @DEFAULT_SOURCE@ | grep -q 'yes'; then
  ~/.dotfiles/bin/swayosd-client --custom-message "Microphone muted" --custom-icon microphone-sensitivity-muted-symbolic
else
  ~/.dotfiles/bin/swayosd-client --custom-message "Microphone on" --custom-icon audio-input-microphone-symbolic
fi
