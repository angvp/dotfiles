#!/bin/bash
weather=$(curl -fsS --max-time 4 "https://wttr.in?format=%l|%t|%w" 2>/dev/null | tr -d '\n')
[[ -z $weather ]] && echo "Weather unavailable" && exit 1
IFS='|' read -r place temperature wind <<< "$weather"
place="${place%%,*}"; place="${place^}"; temperature="${temperature#+}"
echo "    $place  ·  $temperature  ·  Wind $wind"
